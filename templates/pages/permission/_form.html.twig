{# Permission fields (PermissionType). #}
{% trans_default_domain 'GingermindsCore' %}
{% embed '@GingermindsCore/crud/_form_layout.html.twig' %}
    {% trans_default_domain 'GingermindsCore' %}

    {% block main %}
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex align-items-center py-3">
                <h2 class="card-title h5 mb-0"><i class="bi bi-key me-1 text-primary"></i> {{ 'permission.name_s'|trans }}</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.name, {size_columns: 12, attr: {placeholder: 'permission.placeholder.name'|trans}}) }}
                </div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
