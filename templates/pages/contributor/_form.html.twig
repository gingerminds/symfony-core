{# Contributor fields (ContributorType): identity card and associated user card. #}
{% trans_default_domain 'GingermindsCore' %}
{% embed '@GingermindsCore/crud/_form_layout.html.twig' %}
    {% trans_default_domain 'GingermindsCore' %}

    {% block main %}
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex align-items-center py-3">
                <h2 class="card-title h5 mb-0"><i class="bi bi-person-badge me-1 text-primary"></i> {{ 'contributor.name_s'|trans }}</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.civility) }}
                    <div class="w-100 m-0"></div>
                    {{ form_row(form.lastname) }}
                    {{ form_row(form.firstname) }}
                    {{ form_row(form.trigram) }}
                </div>
            </div>
        </div>
    {% endblock %}

    {% block sidebar %}
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex align-items-center py-3">
                <h2 class="card-title h5 mb-0"><i class="bi bi-person-check me-1 text-primary"></i> {{ 'contributor.field.user'|trans }}</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">{{ form_row(form.user, {size_columns: 12}) }}</div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
