{#
 # Session flash messages (app.flashes), one dismissible alert per message.
 # `error` is displayed as `danger`.
 #}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'action.close'|trans({}, 'GingermindsCore') }}"></button>
        </div>
    {% endfor %}
{% endfor %}
