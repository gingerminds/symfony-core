{# Text filter (`search`, `partial`, `exact` without choices): `<property>`. Vars: property, label, value, placeholder?, error? #}
<div class="col-md-4">
    <label for="filter-{{ property }}" class="form-label">{{ label }}</label>
    <input type="text" name="{{ property }}" id="filter-{{ property }}" class="form-control{{ (error ?? null) ? ' is-invalid' }}"
           value="{{ value is iterable ? '' : value }}"{% if placeholder ?? null %} placeholder="{{ placeholder }}"{% endif %}>
    {% if error ?? null %}<div class="invalid-feedback d-block">{{ error }}</div>{% endif %}
</div>
