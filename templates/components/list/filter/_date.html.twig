{# Date range filter (days of the display timezone): <property>[after] / <property>[before]. Vars: property, config, value, label #}
{% trans_default_domain 'GingermindsCore' %}
{% for bound, bound_label in {after: 'common.from', before: 'common.to'} %}
    <div class="col-md-2">
        <label for="filter-{{ property }}-{{ bound }}" class="form-label">{{ label }} | {{ bound_label|trans }}</label>
        <input type="date" class="form-control" id="filter-{{ property }}-{{ bound }}"
               name="{{ property }}[{{ bound }}]" value="{{ value is iterable ? (value[bound] ?? '') : '' }}">
    </div>
{% endfor %}
