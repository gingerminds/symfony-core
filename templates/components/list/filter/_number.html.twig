{# Number range filter: <property>[gte] / <property>[lte]. Vars: property, config, value, label, error? #}
{% trans_default_domain 'GingermindsCore' %}
{% for bound, bound_label in {gte: 'common.number_from', lte: 'common.number_to'} %}
    <div class="col-md-2">
        <label for="filter-{{ property }}-{{ bound }}" class="form-label">{{ label }} | {{ bound_label|trans }}</label>
        <input type="number" step="{{ config.step ?? 'any' }}"{% if config.min is defined %} min="{{ config.min }}"{% endif %} placeholder="0.00" class="form-control{{ (error ?? null) ? ' is-invalid' }}"
               id="filter-{{ property }}-{{ bound }}" name="{{ property }}[{{ bound }}]"
               value="{{ value is iterable ? (value[bound] ?? '') : '' }}">
        {% if loop.first %}{% if error ?? null %}<div class="invalid-feedback d-block">{{ error }}</div>{% endif %}{% endif %}
    </div>
{% endfor %}
