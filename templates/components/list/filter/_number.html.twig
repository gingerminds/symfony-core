{# Number range filter: filters[property][from] / filters[property][to]. Vars: property, config, value, label #}
{% trans_default_domain 'GingermindsCore' %}
{% for bound in ['from', 'to'] %}
    <div class="col-md-2">
        <label for="filter-{{ property }}-{{ bound }}" class="form-label">{{ label }} | {{ ('common.number_' ~ bound)|trans }}</label>
        <input type="number" step="{{ config.step ?? 'any' }}"{% if config.min is defined %} min="{{ config.min }}"{% endif %} placeholder="0.00" class="form-control"
               id="filter-{{ property }}-{{ bound }}" name="filters[{{ property }}][{{ bound }}]"
               value="{{ value is iterable ? (value[bound] ?? '') : '' }}">
    </div>
{% endfor %}
