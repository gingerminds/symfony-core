{#
 # Page size selector: navigates to the same list with `itemsPerPage`
 # (Stimulus `gm-items-per-page`, which also resets the page).
 # Vars: items (Paginator), options? (default [10, 25, 50, 100])
 #}
{% trans_default_domain 'GingermindsCore' %}
{% set current = items.getItemsPerPage %}
{% set options = (options ?? [10, 25, 50, 100]) %}
{% if current not in options %}{% set options = (options|merge([current]))|sort %}{% endif %}
<select class="form-select form-select-sm w-auto" aria-label="{{ 'list.items_per_page'|trans }}"
        data-controller="gm-items-per-page" data-action="gm-items-per-page#change">
    {% for option in options %}
        <option value="{{ option }}"{{ option == current ? ' selected' }}>{{ 'common.display'|trans }}&nbsp;{{ option }}</option>
    {% endfor %}
</select>
