{#
 # Pagination (2 pages around the current one), links built with gm_list_path().
 # Vars: items (Paginator), list_query, route, route_parameters?
 #}
{% trans_default_domain 'GingermindsCore' %}
{% set route_parameters = route_parameters ?? {} %}
{% set current = items.getPage %}
{% set last = items.getLastPage %}
{% if last > 1 %}
    {% set start = max(current - 2, 1) %}
    {% set end = min(current + 2, last) %}
    <nav aria-label="{{ 'list.pagination'|trans }}">
        <ul class="pagination justify-content-center">
            {% for link in [
                {page: 1, icon: 'bi-chevron-double-left', label: 'list.first', disabled: current == 1},
                {page: current - 1, icon: 'bi-chevron-left', label: 'common.previous', disabled: not items.hasPreviousPage},
            ] %}
                <li class="page-item{{ link.disabled ? ' disabled' }}">
                    <a class="page-link" href="{{ link.disabled ? '#' : gm_list_path(route, list_query, {page: link.page}, route_parameters) }}" aria-label="{{ link.label|trans }}">
                        <i class="bi {{ link.icon }}"></i>
                    </a>
                </li>
            {% endfor %}

            {% for page in start..end %}
                <li class="page-item{{ page == current ? ' active' }}"{% if page == current %} aria-current="page"{% endif %}>
                    <a class="page-link" href="{{ gm_list_path(route, list_query, {page: page}, route_parameters) }}">{{ page }}</a>
                </li>
            {% endfor %}

            {% for link in [
                {page: current + 1, icon: 'bi-chevron-right', label: 'common.next', disabled: not items.hasNextPage},
                {page: last, icon: 'bi-chevron-double-right', label: 'list.last', disabled: current == last},
            ] %}
                <li class="page-item{{ link.disabled ? ' disabled' }}">
                    <a class="page-link" href="{{ link.disabled ? '#' : gm_list_path(route, list_query, {page: link.page}, route_parameters) }}" aria-label="{{ link.label|trans }}">
                        <i class="bi {{ link.icon }}"></i>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endif %}
