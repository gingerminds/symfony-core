{#
 # HTML document shared by the admin layouts (guest.html.twig, base.html.twig):
 # <head> (meta, title, importmap, admin stylesheet) and an empty <body>.
 #
 # Blocks: title, javascripts, stylesheets, body_attributes, body.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr')|replace({'_': '-'}) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="Gingerminds">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{% endblock %} | {{ gm_admin_title() }}</title>
    {% block javascripts %}
        {{ importmap('gingerminds-core-admin') }}
    {% endblock %}
    {# After importmap(): its vendor CSS (Tom Select theme, bootstrap-icons) must
     # come first so the admin stylesheet overrides it. #}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('gingerminds-core/styles/admin.scss') }}">
    {% endblock %}
</head>
<body{% block body_attributes %}{% endblock %}>
{% block body %}{% endblock %}
</body>
</html>
