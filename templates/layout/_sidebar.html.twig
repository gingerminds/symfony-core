{#
 # Admin sidebar: logo, menu from gm_admin_menu() (AdminMenuProviderInterface
 # services), current user menu (profile, logout) pinned at the bottom,
 # collapse-to-icons toggle (Stimulus `gm-sidebar`, remembered in localStorage).
 #
 # Blocks: sidebar_logo, sidebar_profile.
 #}
{% trans_default_domain 'GingermindsCore' %}
<nav class="sidebar d-flex flex-column flex-shrink-0" id="gm-sidebar" data-controller="gm-sidebar" aria-label="{{ 'menu.main'|trans }}">
    <button type="button" class="sidebar-toggle" data-action="gm-sidebar#toggle" aria-controls="gm-sidebar" title="{{ 'menu.toggle'|trans }}">
        <span class="sidebar-toggle-icon"></span>
        <span class="visually-hidden">{{ 'menu.toggle'|trans }}</span>
    </button>

    {% block sidebar_logo %}
        <a href="{{ path('gingerminds_core_dashboard') }}" class="d-flex align-items-center justify-content-center mb-3 mb-md-0 text-white text-decoration-none">
            <span class="fs-4 logo-text">{{ gm_admin_title() }}</span>
        </a>
    {% endblock %}
    <hr>

    <div class="sidebar-menu">
        <ul class="list-unstyled ps-0" id="gm-sidebar-menu">
            {% for item in gm_admin_menu() %}
                {% include '@GingermindsCore/layout/_menu_item.html.twig' with {item: item, index: loop.index} only %}
            {% endfor %}
        </ul>
    </div>

    {% block sidebar_profile %}
        {% set user = app.user %}
        {% if user %}
            {% set contributor = user.contributor ?? null %}
            {% set display_name = contributor and contributor.fullName ? contributor.fullName : user.userIdentifier %}
            {% set first_role = (user.roleEntities ?? [])|first %}
            <hr>
            <div class="dropup">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle sidebar-profile-toggle"
                   data-bs-toggle="dropdown" aria-expanded="false" title="{{ display_name }}">
                    {% if contributor and contributor.avatar %}
                        <img src="{{ contributor.avatar }}" alt="" width="32" height="32" class="rounded-circle me-2">
                    {% else %}
                        <span class="sidebar-avatar rounded-circle me-2 d-flex flex-shrink-0 align-items-center justify-content-center fw-bold">
                            {{- display_name|first|upper -}}
                        </span>
                    {% endif %}
                    <span class="profile-info">
                        <strong class="d-block text-truncate">{{ display_name }}</strong>
                        {% if first_role %}<small class="profile-role d-block text-truncate">{{ first_role.name }}</small>{% endif %}
                    </span>
                </a>
                <ul class="dropdown-menu shadow">
                    <li>
                        <a class="dropdown-item" href="{{ path('gingerminds_core_profile') }}">
                            <i class="bi bi-person-gear me-2"></i>{{ 'profile.settings'|trans }}
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="{{ path('gingerminds_core_logout') }}">
                            <i class="bi bi-box-arrow-right me-2"></i>{{ 'action.sign_out'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        {% endif %}
    {% endblock %}
</nav>
