{#
 # Topbar: current user menu (profile, logout).
 #}
{% trans_default_domain 'GingermindsCore' %}
{% set user = app.user %}
<header class="gm-topbar">
    {% block topbar_start %}{% endblock %}
    {% if user %}
        {% set contributor = user.contributor ?? null %}
        {% set display_name = contributor and contributor.fullName ? contributor.fullName : user.userIdentifier %}
        {% set first_role = (user.roleEntities ?? [])|first %}
        <div class="dropdown">
            <a href="#" class="gm-user-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {% if contributor and contributor.avatar %}
                    <img src="{{ contributor.avatar }}" alt="" width="32" height="32" class="rounded-circle">
                {% else %}
                    <span class="gm-user-avatar rounded-circle d-flex align-items-center justify-content-center fw-bold">
                        {{- display_name|first|upper -}}
                    </span>
                {% endif %}
                <span class="gm-user-info d-none d-sm-block">
                    <strong class="d-block">{{ display_name }}</strong>
                    {% if first_role %}<small class="d-block">{{ first_role.name }}</small>{% endif %}
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <a class="dropdown-item" href="{{ path('gingerminds_core_profile') }}">
                        <i class="bi bi-person-gear me-2"></i>{{ 'profile.settings'|trans }}
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="{{ path('gingerminds_core_logout') }}">
                        <i class="bi bi-box-arrow-right me-2"></i>{{ 'action.sign_out'|trans }}
                    </a>
                </li>
            </ul>
        </div>
    {% endif %}
</header>
